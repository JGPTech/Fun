  <data key="d0">Bellman Recurrence</data>
  <data key="d1">tool</data>
  <data key="d2">3</data>
  <data key="d3">V(s)=max_a sum K(s'|s,a)V(s').</data>
  <data key="d4">#8e44ad</data>
</node>
