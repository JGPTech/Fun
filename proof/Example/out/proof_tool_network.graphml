  <data key="d0">Tier-Weight Potential</data>
  <data key="d1">lemma</data>
  <data key="d2">2</data>
  <data key="d3">omega(s)=t1+2t2+4t3+8t4.</data>
  <data key="d4">#1abc9c</data>
</node>
