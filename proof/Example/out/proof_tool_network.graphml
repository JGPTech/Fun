  <data key="d0">Minimal 8-Horses Lemma</data>
  <data key="d1">lemma</data>
  <data key="d2">4</data>
  <data key="d3">f(X)=0 for X&lt;8 and f(8)=(1/5)^7.</data>
  <data key="d4">#1abc9c</data>
</node>
